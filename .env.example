# Copy to .env. Docker compose overrides DB_* and OLLAMA_BASE_URL for containers;
# these values are for running on the host (CLI, pytest, alembic).

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=multi_tenant_agent_db

OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3:8b
OLLAMA_KEEP_ALIVE=30m
WARMUP_ON_STARTUP=true
# Optional second model used when the primary fails (pull it first)
OLLAMA_FALLBACK_MODEL=

# Root password for the MySQL container in compose
DOCKER_DB_PASSWORD=agentpass

APP_ENV=dev
LOG_LEVEL=INFO

# Auth: HS256 secret (>= 32 chars) or an OIDC provider's JWKS URL (RS256).
# APP_ENV=prod refuses to start with the default dev secret.
JWT_SECRET=dev-insecure-secret-change-me-0123456789
JWT_JWKS_URL=
JWT_ISSUER=multi-tenant-agent
JWT_AUDIENCE=multi-tenant-agent

# Unset = in-memory store (single process only)
REDIS_URL=

RATE_LIMIT_USER_PER_MINUTE=20
RATE_LIMIT_TENANT_PER_MINUTE=100
